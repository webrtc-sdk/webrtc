import("../../webrtc.gni")

rtc_library("frame_metadata_transformer") {
  visibility = [ "*" ]
  sources = [
    "frame_metadata_transformer.cc",
    "frame_metadata_transformer.h",
  ]
  deps = [
    "..:frame_transformer_interface",
    "..:make_ref_counted",
    "..:scoped_refptr",
    "../../rtc_base:checks",
    "../../rtc_base:logging",
    "../../rtc_base:macromagic",
    "../../rtc_base/synchronization:mutex",
    "../../rtc_base/system:rtc_export",
    "../units:timestamp",
  ]
}

if (rtc_include_tests) {
  rtc_library("frame_metadata_unittests") {
    testonly = true
    sources = [ "frame_metadata_transformer_unittest.cc" ]
    deps = [
      ":frame_metadata_transformer",
      "..:frame_transformer_interface",
      "..:make_ref_counted",
      "..:mock_transformable_video_frame",
      "..:scoped_refptr",
      "../../test:test_support",
      "../units:timestamp",
    ]
  }
}
